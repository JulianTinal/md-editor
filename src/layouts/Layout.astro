---
import '@/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MD Editor — Escribe en Markdown, exporta en segundos",
  description = "Editor de Markdown con vista previa en vivo y exportación a PDF y Word con tipografía profesional. Sin cuentas, sin esperas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <slot />
  </body>
</html>
