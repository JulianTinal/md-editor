---
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  width="56"
  height="56"
  viewBox="0 0 56 56"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="shield-grad" x1="14" y1="6" x2="42" y2="50" gradientUnits="userSpaceOnUse">
      <stop stop-color="#10b981" stop-opacity="0.18" />
      <stop offset="1" stop-color="#10b981" stop-opacity="0.04" />
    </linearGradient>
  </defs>

  <path
    d="M28 4 L46 12 L46 28 C46 40 38 48 28 52 C18 48 10 40 10 28 L10 12 Z"
    fill="url(#shield-grad)"
    stroke="#98989f"
    stroke-width="1.2"
  />

  <path
    d="M20 28 L25 33 L36 22"
    stroke="#10b981"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />

  <circle cx="14" cy="20" r="0.8" fill="#10b981" opacity="0.4" />
  <circle cx="42" cy="20" r="0.8" fill="#10b981" opacity="0.4" />
  <circle cx="14" cy="38" r="0.8" fill="#10b981" opacity="0.4" />
  <circle cx="42" cy="38" r="0.8" fill="#10b981" opacity="0.4" />
</svg>
