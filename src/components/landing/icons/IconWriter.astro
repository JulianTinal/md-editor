---
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  width="56"
  height="56"
  viewBox="0 0 56 56"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="writer-grad" x1="8" y1="10" x2="48" y2="46" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7c3aed" stop-opacity="0.18" />
      <stop offset="1" stop-color="#7c3aed" stop-opacity="0.04" />
    </linearGradient>
  </defs>

  <rect x="6" y="10" width="36" height="40" rx="3" fill="url(#writer-grad)" stroke="#7c3aed" stroke-width="1.2" />

  <line x1="12" y1="20" x2="32" y2="20" stroke="#98989f" stroke-width="1.2" stroke-linecap="round" />
  <line x1="12" y1="26" x2="36" y2="26" stroke="#98989f" stroke-width="1.2" stroke-linecap="round" />
  <line x1="12" y1="32" x2="28" y2="32" stroke="#98989f" stroke-width="1.2" stroke-linecap="round" />
  <line x1="12" y1="38" x2="34" y2="38" stroke="#98989f" stroke-width="1.2" stroke-linecap="round" />
  <line x1="12" y1="44" x2="24" y2="44" stroke="#98989f" stroke-width="1.2" stroke-linecap="round" />

  <g>
    <rect x="30" y="30" width="20" height="20" rx="2" fill="#1a1a20" stroke="#f4f4f7" stroke-width="1.2" />
    <path
      d="M40 36 L46 36 M40 40 L44 40"
      stroke="#f4f4f7"
      stroke-width="1.2"
      stroke-linecap="round"
    />
    <circle cx="40" cy="44" r="1.5" fill="#7c3aed" />
  </g>

  <circle cx="14" cy="14" r="1.5" fill="#7c3aed" />
  <path d="M14 12.5 L14 15.5" stroke="#0a0a0c" stroke-width="1" stroke-linecap="round" />
</svg>
