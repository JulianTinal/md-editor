---

<div class="relative h-full w-full overflow-hidden bg-(--color-bg-base) text-(--color-text-primary)" id="animated-editor" data-examples={JSON.stringify(examples)}>
  <!-- Window chrome -->
  <div class="flex items-center justify-between border-b border-(--color-border-faint) bg-(--color-bg-soft) px-3 py-2">
    <div class="flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </div>
    <div class="flex items-center gap-2 rounded-md bg-(--color-bg-inset) px-2.5 py-1 font-mono text-[10.5px] text-(--color-text-tertiary)">
      <span class="text-(--color-text-dim)">●</span>
      <span id="ae-filename">lanzamiento-v2.md</span>
      <span class="text-(--color-text-dim)">·</span>
      <span class="text-(--color-signal)">saved</span>
    </div>
    <div class="hidden items-center gap-1.5 sm:flex">
      <span class="rounded-md p-1 text-(--color-text-dim)">
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v16.5h16.5" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="flex items-center justify-between border-b border-(--color-border-faint) bg-(--color-bg-soft) px-3 py-1.5">
    <div class="flex items-center gap-3 font-mono text-[10.5px] text-(--color-text-tertiary)">
      <span class="font-semibold tracking-tight text-(--color-text-primary)">MD EDITOR</span>
      <span class="text-(--color-text-dim)">·</span>
      <span id="ae-toolbar-filename">lanzamiento-v2.md</span>
    </div>
    <div class="flex items-center gap-2 font-mono text-[10.5px] text-(--color-text-tertiary)">
      <span class="hidden sm:inline"><span id="ae-wordcount">130</span>W</span>
      <span class="hidden text-(--color-text-dim) sm:inline">·</span>
      <span class="flex items-center gap-1">
        <span class="ae-pulse inline-block h-1 w-1 rounded-full bg-(--color-signal)"></span>
        READY
      </span>
    </div>
  </div>

  <!-- Split panes -->
  <div class="grid h-[280px] grid-cols-1 sm:grid-cols-2 sm:h-[340px]">
    <!-- MD source with typing animation -->
    <div class="ae-md-pane relative border-b border-(--color-border-faint) bg-(--color-bg-base) p-4 font-mono text-[12.5px] leading-[1.8] text-(--color-text-secondary) sm:border-b-0 sm:border-r overflow-y-auto" id="ae-md-pane">
      <div id="ae-md-content" class="whitespace-pre-wrap"></div>
      <span id="ae-cursor" class="ae-caret inline-block h-[1.2em] w-[0.55em] -mb-[0.15em] ml-[1px] bg-(--color-accent-bright) align-middle"></span>
    </div>
    <!-- Preview (pre-rendered, fades in) -->
    <div class="ae-preview-pane relative bg-(--color-bg-surface) p-5 overflow-y-auto" id="ae-preview-pane">
      <div id="ae-preview-content" class="prose prose-sm max-w-none"></div>
    </div>
  </div>

  <!-- Status bar -->
  <div class="flex items-center justify-between border-t border-(--color-border-faint) bg-(--color-bg-soft) px-3 py-1.5 font-mono text-[10px] tracking-tight text-(--color-text-tertiary)">
    <div class="flex items-center gap-3">
      <span>UTF-8</span>
      <span class="text-(--color-text-dim)">·</span>
      <span>MARKDOWN</span>
    </div>
    <div class="flex items-center gap-3">
      <span id="ae-status">LN 1, COL 1</span>
      <span class="text-(--color-text-dim)">·</span>
      <span class="flex items-center gap-1 text-(--color-signal)">
        <span class="inline-block h-1 w-1 rounded-full bg-(--color-signal)"></span>
        NO ERRORS
      </span>
    </div>
    <div class="hidden items-center gap-3 sm:flex">
      <span>CLIENT-SIDE</span>
      <span class="text-(--color-text-dim)">·</span>
      <span>SIN RASTREO</span>
    </div>
  </div>
</div>

<script>
  // Animated editor: types out markdown, shows pre-rendered preview, cycles through examples
  (() => {
    const root = document.getElementById('animated-editor');
    if (!root) return;
    const examples = JSON.parse(root.dataset.examples || '[]');
    if (!examples.length) return;

    const mdContent = document.getElementById('ae-md-content') as HTMLElement | null;
    const cursor = document.getElementById('ae-cursor') as HTMLElement | null;
    const filename = document.getElementById('ae-filename');
    const toolbarFilename = document.getElementById('ae-toolbar-filename');
    const wordcount = document.getElementById('ae-wordcount');
    const previewContent = document.getElementById('ae-preview-content');
    const status = document.getElementById('ae-status');
    if (!mdContent || !cursor || !filename || !toolbarFilename || !wordcount || !previewContent || !status) return;

    // Wait for fonts to load so column counts look right from the start
    let exampleIndex = 0;
    let charIndex = 0;
    let mode: 'typing' | 'holding' | 'deleting' = 'typing';
    let timer: number | null = null;
    const TYPE_DELAY = 18; // ms per char when typing
    const DELETE_DELAY = 8; // ms per char when deleting
    const HOLD_AFTER_TYPE = 3500; // ms to show after fully typed
    const HOLD_AFTER_DELETE = 400; // ms pause after deletion

    // Position the cursor at the end of the typed content
    function moveCursorToEnd() {
      if (!mdContent || !cursor) return;
      const parent = cursor.parentElement;
      if (!parent) return;
      // Move the cursor to be the next sibling of mdContent
      if (cursor.previousSibling !== mdContent) {
        parent.appendChild(cursor);
      }
    }

    function setFilename(text: string) {
      filename.textContent = text;
      toolbarFilename.textContent = text;
    }

    function setWordcount(src: string) {
      const words = src.trim().split(/\s+/).filter(Boolean).length;
      wordcount.textContent = String(words);
    }

    function setStatus(src: string) {
      const lines = src.split('\n').length;
      const currentLine = Math.min(lines, 14);
      status.textContent = `LN ${currentLine}, COL 1`;
    }

    function showPreview(html: string) {
      previewContent.innerHTML = html;
      // re-trigger fade-in
      previewContent.style.opacity = '0';
      requestAnimationFrame(() => {
        previewContent.style.transition = 'opacity 0.35s ease-out';
        previewContent.style.opacity = '1';
      });
    }

    function step() {
      const ex = examples[exampleIndex];
      const current = mdContent.textContent || '';

      if (mode === 'typing') {
        if (charIndex < ex.source.length) {
          // Add next character (handle \n properly)
          const nextChunk = ex.source.slice(charIndex, charIndex + 1);
          if (nextChunk === '\n') {
            mdContent.appendChild(document.createTextNode('\n'));
          } else {
            mdContent.appendChild(document.createTextNode(nextChunk));
          }
          charIndex++;
          setWordcount(mdContent.textContent || '');
          setStatus(mdContent.textContent || '');
          moveCursorToEnd();
          timer = window.setTimeout(step, TYPE_DELAY);
        } else {
          // Done typing, show preview and hold
          showPreview(ex.preview);
          mode = 'holding';
          timer = window.setTimeout(() => {
            mode = 'deleting';
            step();
          }, HOLD_AFTER_TYPE);
        }
      } else if (mode === 'deleting') {
        if (current.length > 0) {
          mdContent.textContent = current.slice(0, -1);
          setWordcount(mdContent.textContent || '');
          setStatus(mdContent.textContent || '');
          moveCursorToEnd();
          timer = window.setTimeout(step, DELETE_DELAY);
        } else {
          // Done deleting, next example
          mode = 'typing';
          charIndex = 0;
          exampleIndex = (exampleIndex + 1) % examples.length;
          setFilename(examples[exampleIndex].label);
          timer = window.setTimeout(step, HOLD_AFTER_DELETE);
        }
      }
    }

    // Initialize with first example filename, but start empty
    setFilename(examples[0].label);
    showPreview(examples[0].preview);
    setWordcount('');
    setStatus('');

    // Start the loop after a brief pause
    timer = window.setTimeout(step, 600);
  })();
</script>
