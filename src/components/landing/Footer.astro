---
import { repoUrl } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer id="footer" class="relative border-t border-(--color-border-faint) bg-(--color-bg-inset)">
  <div class="mx-auto max-w-[1320px] px-4 py-9 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex shrink-0 items-center" aria-label="MD Editor — inicio">
          <img src="/img-logo.svg" alt="MD Editor" class="logo-glow h-9 w-auto" width="141" height="36" />
        </a>
        <span class="hidden h-7 w-px bg-(--color-border-faint) sm:block" aria-hidden="true"></span>
        <p class="hidden text-[14px] text-(--color-text-tertiary) lg:block">
          Markdown a PDF y Word, en tu navegador
        </p>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-2 text-[14px]">
        <a
          href="/editor"
          class="font-medium text-(--color-text-secondary) transition-colors hover:text-(--color-accent-bright)"
        >
          Abrir el editor
        </a>
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 font-medium text-(--color-text-secondary) transition-colors hover:text-(--color-accent-bright)"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          Código
        </a>
        <span class="inline-flex items-center gap-1.5 text-[13px] text-(--color-text-dim)">
          <span>Hecho con</span>
          <svg class="h-3.5 w-3.5 text-(--color-accent)" viewBox="0 0 24 24" fill="currentColor" aria-label="amor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
          <span>por Julian Varguez</span>
          <span class="text-(--color-text-dim)/60" aria-hidden="true">·</span>
          <span>© {year} · MIT</span>
        </span>
      </nav>
    </div>
  </div>
</footer>
